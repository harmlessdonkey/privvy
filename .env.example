# Copy to .env and fill in. .env is git-ignored.

# Used ONLY to create the first admin when no users exist yet.
# Remove the password from .env after first start.
PRIVVY_ADMIN_USERNAME=admin
PRIVVY_ADMIN_PASSWORD=

# Optional. If unset, a key is generated and kept in data/config/.session-key
# PRIVVY_SESSION_SECRET=

# Set to true once served over HTTPS (marks the session cookie Secure).
PRIVVY_COOKIE_SECURE=false
